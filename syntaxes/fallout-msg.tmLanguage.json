{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fallout Star-Trek Scripting Language message",
  "scopeName": "source.fallout-msg",
  "patterns": [
    {
      "include": "#entries"
    },
    {
      "include": "#skipped"
    },
    {
      "include": "#stray-braces"
    }
  ],
  "repository": {
    "skipped": {
      "patterns": [
        {
          "match": "[^{}]+",
          "name": "comment.line.fallout-msg"
        }
      ]
    },
    "stray-braces": {
      "patterns": [
        {
          "match": "[{}]",
          "name": "invalid.illegal.fallout-msg"
        }
      ]
    },
    "entries": {
      "patterns": [
        {
          "begin": "({)([+-]?\\d+)(}{)([^}]*)(}{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.fallout-msg"
            },
            "2": {
              "name": "constant.other.linenum.fallout-msg"
            },
            "3": {
              "name": "keyword.control.fallout-msg"
            },
            "4": {
              "name": "entity.name.function.sound.fallout-msg"
            },
            "5": {
              "name": "keyword.control.fallout-msg"
            }
          },
          "end": "(})",
          "endCaptures": {
            "1": {
              "name": "keyword.control.fallout-msg"
            }
          },
          "name": "string.quoted.fallout-msg"
        }
      ]
    }
  }
}