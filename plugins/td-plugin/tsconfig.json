{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["es2024", "es2025.collection"],
        // TS Language Service plugins must use `export = init` (CommonJS module.exports).
        // verbatimModuleSyntax conflicts with `export =` in CommonJS modules, so it is disabled here.
        // `preserve` with bundler resolution because the plugin is never loaded unbundled:
        // scripts/build-ts-plugin.sh bundles it with esbuild --format=cjs, which inlines the ES modules of
        // `@bgforge/shared` that node16 would refuse a CommonJS file to import. `node` (node10) is gone in
        // TS 7 and made the package unanalysable by the type-aware lint.
        "verbatimModuleSyntax": false,
        "module": "preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "tsBuildInfoFile": "../../tmp/td-plugin.tsbuildinfo"
    },
    "include": ["src"]
}
