{
    "compilerOptions": {
        // Matches the `lib` every package config sets, which follows the Node inside the oldest VS Code
        // `engines.vscode` admits (docs/dependencies.md).
        // Emit is unaffected - `noEmit` here, and the bundles are built by tsdown/esbuild.
        "target": "es2024",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "incremental": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        // The type-aware lint runs on the TS 7 engine while tsc is still 6.x; pinning the
        // ordering keeps the two from disagreeing on inferred union member order.
        "stableTypeOrdering": true,
        // Stated rather than inferred: TS 6.0 narrows which @types packages are included
        // automatically, and without this the Node globals stop resolving across most of the
        // workspace configs.
        "types": ["node"]
    }
}
