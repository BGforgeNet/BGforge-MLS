*.log
*.tgz
*.vsix
*.tsbuildinfo
*.tmbundle
*.zip
dist/
syntaxes-to-json.sh.err
# Editor-bundle staging dirs. build-editors.sh now stages them under dist/, so this only
# catches one left at the root by a build from before that change.
/bgforge-mls*/
.reports/
.vscode-test/
.dev/
.playwright-mcp/
# package.sh removes this staging dir on both entry and exit; a run that dies in between leaves it.
.pkg-inject/

client/node_modules
client/out

server/node_modules
server/out/*
# Generated from server/data/*.yml by generate-data.sh, but tracked so that tests and typechecks
# work on a clean checkout with no build step.
!server/out/completion.*.json
!server/out/signature.*.json
!server/out/fallout-ssl-engine-proc-docs.json
!server/out/fallout-ssl-engine-procedures.json

transpilers/out
format/out
binary/out
image/out
compilers/ssl/out
compilers/tssl/out

plugins/*/out

# Cloned third-party mod repos used as test fixtures. The tracked .txt files say which repos to
# clone and what to exclude; reset-external.sh reads them.
external/*
!external/fallout.txt
!external/fallout-exclude.txt
!external/infinity-engine.txt
!external/infinity-engine-exclude.txt
node_modules
.npmrc
.pnpm-store/
tmp

*.wasm

# Test coverage reports
coverage/

# Generated tree-sitter parser sources (src/ dir is generated, but scanner.c is hand-written)
grammars/*/src/*
!grammars/*/src/scanner.c
# Generated tree-sitter node-type declarations (regenerated by build:grammar / generate:types).
# The runtime SyntaxType enum in shared/syntax-types/ stays tracked; these .d.ts do not.
server/src/*/tree-sitter.d.ts
