// line comment
// <- comment
/* block comment */
// <- comment
@100 = ~Hello world~ [SOUND01]
// <- punctuation.delimiter
//^^ number
//   ^ punctuation.delimiter
//     ^ string
//                   ^ string
//                     ^ string.special
@200 = "double quoted"
//     ^ string
@300 = ~Hi~ [%v%SND]
//           ^ string.special
@301 = ~m~ [A] ~f~ [B]
//         ^ string.special
//                 ^ string.special
@302 = %pct%
//      ^ string
