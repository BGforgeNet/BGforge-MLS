{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "packageManager": "pnpm",
    "testRunner": "vitest",
    "plugins": ["@stryker-mutator/typescript-checker", "@stryker-mutator/vitest-runner"],
    "vitest": {
        "configFile": "binary/vitest.mutation.config.ts",
        "dir": "binary"
    },
    "mutate": [
        "binary/src/spec/types.ts",
        "binary/src/ie-common/ability-effects-writer.ts",
        "binary/src/cre/canonical-writer.ts",
        "binary/src/map/canonical-writer.ts"
    ],
    "checkers": ["typescript"],
    "tsconfigFile": "binary/tsconfig.json",
    "ignorePatterns": ["external", "tmp", ".vscode-test", ".dev"],
    "coverageAnalysis": "perTest",
    "thresholds": {
        "high": 80,
        "low": 57,
        "break": 55
    },
    "reporters": ["clear-text", "progress", "html"],
    "htmlReporter": {
        "fileName": "tmp/mutation/report.html"
    },
    "timeoutMS": 30000,
    "concurrency": 2
}
