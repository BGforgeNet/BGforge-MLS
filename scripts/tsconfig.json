/**
 * TypeScript configuration for all data update scripts.
 * Standalone config (not part of the main build).
 * Overrides module/moduleResolution to NodeNext because scripts run via tsx/node
 * (not bundled), requiring Node-compatible module resolution.
 */
{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["es2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "outDir": "out",
        "sourceMap": true,
        // Stated rather than inferred: sources here import from ../shared, so the source root is
        // the repo, not this directory. Inert under the base config's `noEmit`, but TS 6.0 defaults
        // `rootDir` to the config's own directory and then rejects those files (TS6059).
        "rootDir": "..",
        "tsBuildInfoFile": "../tmp/scripts.tsbuildinfo"
    },
    "include": [
        "ie-update/src",
        "ie-update/test",
        "ie-binary-update/src",
        "ie-binary-update/test",
        "fallout-update/src",
        "fallout-update/test",
        "utils/src",
        "utils/test"
    ],
    "exclude": ["node_modules", "out"]
}
