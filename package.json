{
    "name": "bgforge-mls",
    "displayName": "BGforge MLS",
    "version": "3.13.2",
    "description": "BGforge multilanguage server",
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "Baldur's Gate",
        "Fallout",
        "Infinity Engine",
        "Star-Trek Scripting Language",
        "WeiDU"
    ],
    "homepage": "https://forums.bgforge.net/viewforum.php?f=35",
    "bugs": {
        "url": "https://github.com/BGforgeNet/BGforge-MLS/issues"
    },
    "license": "SEE LICENSE IN LICENSE.txt",
    "author": "BGforge",
    "repository": {
        "type": "git",
        "url": "https://github.com/BGforgeNet/BGforge-MLS"
    },
    "publisher": "BGforge",
    "type": "module",
    "main": "./client/out/extension.js",
    "scripts": {
        "vscode:prepublish": "./scripts/prepublish.sh",
        "prepare": "lefthook install",
        "build": "pnpm build:client && pnpm build:server && pnpm build:test && pnpm build:transpile && pnpm build:format && pnpm build:binary && pnpm build:ssl && pnpm build:tssl",
        "build:dev": "./scripts/build-dev.sh",
        "dev:web": "./scripts/dev-web.sh",
        "build:all": "pnpm build:grammar && pnpm build && pnpm build:editors",
        "build:ts-plugin": "./scripts/build-ts-plugin.sh tssl-plugin",
        "build:td-plugin": "./scripts/build-ts-plugin.sh td-plugin",
        "build:client": "pnpm build:base:client --sourcemap && pnpm build:ts-plugin --sourcemap && pnpm build:td-plugin --sourcemap && pnpm build:base:webviews --sourcemap",
        "build:server": "pnpm build:base:server --sourcemap",
        "build:webviews": "pnpm build:base:webviews --sourcemap",
        "build:test": "./scripts/build-test.sh",
        "build:format": "pnpm --filter @bgforge/format build",
        "build:transpile": "pnpm --filter @bgforge/transpile build",
        "build:binary": "pnpm --filter @bgforge/binary build",
        "build:ssl": "pnpm --filter @bgforge/ssl build",
        "build:tssl": "pnpm --filter @bgforge/tssl build",
        "build:grammar": "bash ./scripts/build-grammar.sh",
        "build:editors": "./scripts/build-editors.sh",
        "build:base:client": "./scripts/build-base-client.sh",
        "build:base:server": "bash ./scripts/build-base-server.sh",
        "build:base:webviews": "./scripts/build-base-webviews.sh",
        "watch:client": "pnpm build:base:client --sourcemap --watch",
        "watch:server": "pnpm build:base:server --sourcemap --watch",
        "test": "./scripts/test.sh",
        "test:all": "./scripts/test-all.sh",
        "test:client": "cd client && pnpm test",
        "test:server": "cd server && pnpm test",
        "test:grammars": "./scripts/test-grammars.sh",
        "test:integration": "cd server && pnpm test:integration",
        "test:external": "./scripts/test-external.sh",
        "test:transpile-external": "./scripts/test-transpile-external.sh",
        "test:grammar": "./scripts/test-grammar.sh",
        "lsp-probe": "tsx server/scripts/lsp-probe.mts",
        "regenerate-expected": "./scripts/regenerate-expected.sh",
        "regen:td-blocklist": "tsx scripts/utils/src/generate-td-lib-blocklist.ts",
        "test:cli": "vitest run --config scripts/vitest.cli.config.ts",
        "test:cli:external": "RUN_EXTERNAL_CLI_TESTS=1 vitest run --config scripts/vitest.cli.config.ts",
        "test:server:smoke": "cd server && pnpm exec vitest run test/smoke-stdio.test.ts",
        "test:e2e": "./scripts/test-e2e.sh",
        "test:coverage": "cd server && vitest run --coverage",
        "package": "./scripts/package.sh",
        "package:grammars": "./scripts/package-grammars.sh && ./scripts/verify-grammar-bundle.sh",
        "format": "node --no-warnings format/out/cli.js",
        "binary": "node binary/out/cli.js",
        "ssl": "node compilers/ssl/out/cli.js",
        "tssl": "node compilers/tssl/out/cli.js",
        "ssl-diff": "tsx compilers/ssl/scripts/ssl-diff.mts",
        "ssl-equiv": "tsx compilers/ssl/scripts/ssl-equiv.mts",
        "ssl-oracles": "tsx compilers/ssl/scripts/ssl-oracles.mts",
        "ssl-verdicts": "tsx compilers/ssl/scripts/ssl-verdicts.mts",
        "tssl-int-diff": "tsx compilers/ssl/scripts/tssl-int-diff.mts",
        "tssl-oracles": "tsx compilers/ssl/scripts/tssl-oracles.mts",
        "lint": "pnpm exec oxlint && pnpm lint:scripts && pnpm lint:shell && pnpm lint:workflows && pnpm lint:md-links",
        "lint:md-links": "pnpm exec remark . --quiet --frail --ignore-path .gitignore --use remark-validate-links",
        "ie-update": "./scripts/ie-update.sh",
        "ie-binary-update": "./scripts/ie-binary-update.sh",
        "fallout-update": "./scripts/fallout-update.sh",
        "generate-data": "./scripts/generate-data.sh",
        "syntaxes-to-json": "./scripts/syntaxes-to-json.sh",
        "update-data": "MLS_SKIP_REGEN=1 pnpm ie-update && MLS_SKIP_REGEN=1 pnpm fallout-update && pnpm generate-data && pnpm syntaxes-to-json",
        "test:scripts": "vitest run --config scripts/vitest.config.ts",
        "lint:scripts": "./scripts/lint-scripts.sh",
        "lint:shell": "./scripts/lint-shell.sh",
        "lint:workflows": "./scripts/lint-workflows.sh",
        "typecheck:svelte": "svelte-check --tsconfig ./client/tsconfig.json",
        "knip": "knip",
        "knip:prod": "knip --production --workspace server --include files",
        "publish:binary": "./scripts/publish-binary.sh",
        "publish:format": "./scripts/publish-format.sh",
        "publish:server": "./scripts/publish-server.sh",
        "publish:transpile": "./scripts/publish-transpile.sh",
        "supply-chain:verify": "./scripts/verify-supply-chain.sh",
        "test:mutation": "stryker run",
        "bench": "cd server && pnpm bench"
    },
    "devDependencies": {
        "@oxlint/plugins": "1.73.0",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/typescript-checker": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "^4.1.10",
        "@vscode/codicons": "^0.0.45",
        "@vscode/vsce": "^3.9.2",
        "cac": "catalog:",
        "diff": "catalog:",
        "esbuild": "^0.28.1",
        "esbuild-svelte": "^0.9.5",
        "jsonc-parser": "^3.3.1",
        "knip": "^6.25.0",
        "lefthook": "^2.1.10",
        "mocha": "^11.7.6",
        "oxfmt": "0.58.0",
        "oxlint": "1.73.0",
        "playwright": "1.61.1",
        "quick-lru": "catalog:",
        "remark-cli": "^12.0.1",
        "remark-validate-links": "^13.1.0",
        "svelte": "^5.56.4",
        "svelte-check": "^4.7.2",
        "tree-sitter-cli": "0.26.9",
        "tsx": "^4.23.0",
        "typescript": "catalog:",
        "vite": "^8.1.4",
        "vitest": "catalog:",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2",
        "web-tree-sitter": "catalog:",
        "yaml": "^2.9.0"
    },
    "contributes": {
        "semanticTokenTypes": [
            {
                "id": "resref",
                "description": "Resource reference variable (spell, item, creature filename)"
            },
            {
                "id": "byte",
                "description": "Byte-typed IESDP constant"
            },
            {
                "id": "char",
                "description": "Char-typed IESDP constant"
            },
            {
                "id": "dword",
                "description": "Dword-typed IESDP constant"
            },
            {
                "id": "int",
                "description": "Integer constant (user-defined or inferred)"
            },
            {
                "id": "2da-c0",
                "description": "2DA table cell: column slot 0 (and every 6th column thereafter)"
            },
            {
                "id": "2da-c1",
                "description": "2DA table cell: column slot 1 (and every 6th column thereafter)"
            },
            {
                "id": "2da-c2",
                "description": "2DA table cell: column slot 2 (and every 6th column thereafter)"
            },
            {
                "id": "2da-c3",
                "description": "2DA table cell: column slot 3 (and every 6th column thereafter)"
            },
            {
                "id": "2da-c4",
                "description": "2DA table cell: column slot 4 (and every 6th column thereafter)"
            },
            {
                "id": "2da-c5",
                "description": "2DA table cell: column slot 5 (and every 6th column thereafter)"
            }
        ],
        "semanticTokenScopes": [
            {
                "scopes": {
                    "resref": [
                        "constant.language.weidu-tp2.resref"
                    ],
                    "byte": [
                        "constant.language.iesdp.byte"
                    ],
                    "char": [
                        "constant.language.iesdp.char"
                    ],
                    "dword": [
                        "constant.language.iesdp.dword"
                    ],
                    "int": [
                        "constant.language.weidu-tp2"
                    ]
                }
            }
        ],
        "languages": [
            {
                "id": "typescript",
                "extensions": [
                    ".tbaf",
                    ".tssl",
                    ".td"
                ]
            },
            {
                "id": "weidu-ssl",
                "aliases": [
                    "WeiDU Stratagems script"
                ],
                "extensions": [
                    ".ssl"
                ],
                "configuration": "./language-configurations/weidu-ssl.language-configuration.json",
                "icon": {
                    "light": "./themes/icons/weidu-baf.png",
                    "dark": "./themes/icons/weidu-baf.png"
                }
            },
            {
                "id": "fallout-ssl",
                "aliases": [
                    "Fallout Star-Trek scripting language"
                ],
                "extensions": [
                    ".ssl",
                    ".h"
                ],
                "configuration": "./language-configurations/fallout-ssl.language-configuration.json",
                "icon": {
                    "light": "./themes/icons/fallout-ssl.svg",
                    "dark": "./themes/icons/fallout-ssl.svg"
                }
            },
            {
                "id": "fallout-ssl-tooltip"
            },
            {
                "id": "fallout-scripts-lst",
                "aliases": [
                    "Fallout scripts list"
                ],
                "filenames": [
                    "scripts.lst"
                ]
            },
            {
                "id": "fallout-worldmap-txt",
                "aliases": [
                    "Fallout worldmap"
                ],
                "filenames": [
                    "worldmap.txt"
                ],
                "configuration": "./language-configurations/fallout-worldmap-txt.language-configuration.json",
                "icon": {
                    "light": "./themes/icons/fallout-worldmap-txt-light.svg",
                    "dark": "./themes/icons/fallout-worldmap-txt.svg"
                }
            },
            {
                "id": "fallout-msg",
                "aliases": [
                    "Fallout message file"
                ],
                "extensions": [
                    ".msg"
                ],
                "configuration": "./language-configurations/fallout-msg.language-configuration.json",
                "icon": {
                    "light": "./themes/icons/seti-msg-tra.svg",
                    "dark": "./themes/icons/seti-msg-tra.svg"
                }
            },
            {
                "id": "weidu-tp2",
                "aliases": [
                    "WeiDU TP2"
                ],
                "extensions": [
                    ".tp2",
                    ".tpa",
                    ".tph",
                    ".tpp"
                ],
                "configuration": "./language-configurations/weidu-tp2.language-configuration.json",
                "icon": {
                    "light": "./themes/icons/weidu-tp2.png",
                    "dark": "./themes/icons/weidu-tp2.png"
                }
            },
            {
                "id": "weidu-tp2-tooltip"
            },
            {
                "id": "weidu-baf",
                "aliases": [
                    "Infinity Engine script"
                ],
                "extensions": [
                    ".baf"
                ],
                "configuration": "./language-configurations/weidu-baf.language-configuration.json",
                "icon": {
                    "light": "./themes/icons/weidu-baf.png",
                    "dark": "./themes/icons/weidu-baf.png"
                }
            },
            {
                "id": "weidu-baf-tooltip"
            },
            {
                "id": "weidu-d",
                "aliases": [
                    "WeiDU dialog"
                ],
                "extensions": [
                    ".d"
                ],
                "configuration": "./language-configurations/weidu-d.language-configuration.json"
            },
            {
                "id": "weidu-d-tooltip"
            },
            {
                "id": "weidu-slb",
                "aliases": [
                    "WeiDU Stratagems library"
                ],
                "extensions": [
                    ".slb"
                ],
                "configuration": "./language-configurations/weidu-slb.language-configuration.json",
                "icon": {
                    "light": "./themes/icons/weidu-baf.png",
                    "dark": "./themes/icons/weidu-baf.png"
                }
            },
            {
                "id": "weidu-tra",
                "aliases": [
                    "WeiDU translation"
                ],
                "extensions": [
                    ".tra"
                ],
                "configuration": "./language-configurations/weidu-tra.language-configuration.json",
                "icon": {
                    "light": "./themes/icons/seti-msg-tra.svg",
                    "dark": "./themes/icons/seti-msg-tra.svg"
                }
            },
            {
                "id": "weidu-log",
                "aliases": [
                    "WeiDU log"
                ],
                "filenames": [
                    "weidu.log"
                ]
            },
            {
                "id": "bgforge-mls-comment"
            },
            {
                "id": "bgforge-mls-string"
            },
            {
                "id": "bgforge-mls-docstring"
            },
            {
                "id": "infinity-2da",
                "aliases": [
                    "Infinity Engine 2DA table"
                ],
                "extensions": [
                    ".2da"
                ],
                "icon": {
                    "light": "./themes/icons/infinity-2da-light.svg",
                    "dark": "./themes/icons/infinity-2da.svg"
                }
            }
        ],
        "configurationDefaults": {
            "[fallout-ssl]": {
                "editor.quickSuggestions": {
                    "comments": "on"
                }
            },
            "[weidu-tp2]": {
                "editor.quickSuggestions": {
                    "comments": "on"
                }
            },
            "files.watcherExclude": {
                "**/.tmp.ssl": true
            },
            "files.exclude": {
                "**/.tmp.ssl": true
            }
        },
        "commands": [
            {
                "command": "extension.bgforge.compile",
                "title": "BGforge MLS: compile"
            },
            {
                "command": "extension.bgforge.dialogEditor",
                "title": "BGforge MLS: Dialog Editor",
                "icon": "$(type-hierarchy)"
            },
            {
                "command": "bgforge.ieResources.openGame",
                "title": "BGforge: Open IE Game...",
                "icon": "$(folder-opened)"
            },
            {
                "command": "bgforge.ieResources.refresh",
                "title": "BGforge: Refresh IE Game Resources",
                "icon": "$(refresh)"
            },
            {
                "command": "bgforge.ieResources.closeGame",
                "title": "BGforge: Close IE Game",
                "icon": "$(close)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "bgforge.ieResources.openGame",
                    "when": "view == bgforge.ieResources",
                    "group": "navigation"
                },
                {
                    "command": "bgforge.ieResources.refresh",
                    "when": "view == bgforge.ieResources && bgforge.ieResources.hasGame",
                    "group": "navigation"
                },
                {
                    "command": "bgforge.ieResources.closeGame",
                    "when": "view == bgforge.ieResources && bgforge.ieResources.hasGame",
                    "group": "navigation"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "bgforgeIeResources",
                    "title": "BGforge",
                    "icon": "themes/icons/ie-game-resources.svg"
                }
            ]
        },
        "views": {
            "bgforgeIeResources": [
                {
                    "id": "bgforge.ieResources",
                    "name": "IE Game Resources",
                    "contextualTitle": "IE Game Resources"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "bgforge.ieResources",
                "contents": "No Infinity Engine game is open.\n[BGforge: Open IE Game...](command:bgforge.ieResources.openGame)"
            }
        ],
        "customEditors": [
            {
                "viewType": "bgforge.intEditor",
                "displayName": "Fallout Script (decompiled)",
                "selector": [
                    {
                        "filenamePattern": "*.int"
                    }
                ],
                "priority": "default"
            },
            {
                "viewType": "bgforge.binaryEditor",
                "displayName": "BGforge Binary Editor",
                "selector": [
                    {
                        "filenamePattern": "*.pro"
                    },
                    {
                        "filenamePattern": "*.map"
                    },
                    {
                        "filenamePattern": "*.itm"
                    },
                    {
                        "filenamePattern": "*.spl"
                    },
                    {
                        "filenamePattern": "*.eff"
                    },
                    {
                        "filenamePattern": "*.cre"
                    }
                ],
                "priority": "default"
            },
            {
                "viewType": "bgforge.animationEditor",
                "displayName": "BGforge Animation Editor",
                "selector": [
                    {
                        "filenamePattern": "*.frm"
                    },
                    {
                        "filenamePattern": "*.fr0"
                    },
                    {
                        "filenamePattern": "*.fr1"
                    },
                    {
                        "filenamePattern": "*.fr2"
                    },
                    {
                        "filenamePattern": "*.fr3"
                    },
                    {
                        "filenamePattern": "*.fr4"
                    },
                    {
                        "filenamePattern": "*.fr5"
                    },
                    {
                        "filenamePattern": "*.bam"
                    }
                ],
                "priority": "default"
            },
            {
                "viewType": "bgforge.dialogEditor",
                "displayName": "BGforge Dialog Editor",
                "selector": [
                    {
                        "filenamePattern": "*.d"
                    },
                    {
                        "filenamePattern": "*.ssl"
                    },
                    {
                        "filenamePattern": "*.td"
                    },
                    {
                        "filenamePattern": "*.tssl"
                    }
                ],
                "priority": "option"
            }
        ],
        "grammars": [
            {
                "language": "weidu-ssl",
                "scopeName": "source.weidu-ssl",
                "path": "./syntaxes/weidu-ssl.tmLanguage.json"
            },
            {
                "language": "fallout-ssl",
                "scopeName": "source.fallout-ssl",
                "path": "./syntaxes/fallout-ssl.tmLanguage.json"
            },
            {
                "language": "fallout-ssl-tooltip",
                "scopeName": "source.fallout-ssl-tooltip",
                "path": "./syntaxes/fallout-ssl-tooltip.tmLanguage.json"
            },
            {
                "language": "fallout-msg",
                "scopeName": "source.fallout-msg",
                "path": "./syntaxes/fallout-msg.tmLanguage.json"
            },
            {
                "language": "fallout-scripts-lst",
                "scopeName": "source.fallout-scripts-lst",
                "path": "./syntaxes/fallout-scripts-lst.tmLanguage.json"
            },
            {
                "language": "fallout-worldmap-txt",
                "scopeName": "source.fallout-worldmap-txt",
                "path": "./syntaxes/fallout-worldmap-txt.tmLanguage.json"
            },
            {
                "language": "weidu-tp2",
                "scopeName": "source.weidu-tp2",
                "path": "./syntaxes/weidu-tp2.tmLanguage.json"
            },
            {
                "language": "weidu-tp2-tooltip",
                "scopeName": "source.weidu-tp2-tooltip",
                "path": "./syntaxes/weidu-tp2-tooltip.tmLanguage.json"
            },
            {
                "language": "weidu-baf",
                "scopeName": "source.weidu-baf",
                "path": "./syntaxes/weidu-baf.tmLanguage.json"
            },
            {
                "language": "weidu-baf-tooltip",
                "scopeName": "source.weidu-baf-tooltip",
                "path": "./syntaxes/weidu-baf-tooltip.tmLanguage.json"
            },
            {
                "language": "weidu-d",
                "scopeName": "source.weidu-d",
                "path": "./syntaxes/weidu-d.tmLanguage.json"
            },
            {
                "language": "weidu-d-tooltip",
                "scopeName": "source.weidu-d-tooltip",
                "path": "./syntaxes/weidu-d-tooltip.tmLanguage.json"
            },
            {
                "language": "weidu-slb",
                "scopeName": "source.weidu-slb",
                "path": "./syntaxes/weidu-slb.tmLanguage.json"
            },
            {
                "language": "weidu-tra",
                "scopeName": "source.weidu-tra",
                "path": "./syntaxes/weidu-tra.tmLanguage.json"
            },
            {
                "language": "weidu-log",
                "scopeName": "source.weidu-log",
                "path": "./syntaxes/weidu-log.tmLanguage.json"
            },
            {
                "language": "bgforge-mls-comment",
                "scopeName": "source.bgforge-mls-comment",
                "path": "./syntaxes/bgforge-mls-comment.tmLanguage.json"
            },
            {
                "language": "bgforge-mls-string",
                "scopeName": "source.bgforge-mls-string",
                "path": "./syntaxes/bgforge-mls-string.tmLanguage.json"
            },
            {
                "language": "bgforge-mls-docstring",
                "scopeName": "source.bgforge-mls-docstring",
                "path": "./syntaxes/bgforge-mls-docstring.tmLanguage.json"
            },
            {
                "language": "infinity-2da",
                "scopeName": "source.infinity-2da",
                "path": "./syntaxes/infinity-2da.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "fallout-ssl",
                "path": "./snippets/fallout-ssl.json"
            },
            {
                "language": "weidu-baf",
                "path": "./snippets/weidu-baf.json"
            },
            {
                "language": "weidu-d",
                "path": "./snippets/weidu-d.json"
            },
            {
                "language": "weidu-tp2",
                "path": "./snippets/weidu-tp2.json"
            }
        ],
        "themes": [
            {
                "label": "BGforge Monokai",
                "uiTheme": "vs-dark",
                "path": "./themes/bgforge-monokai.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "BGforge MLS",
            "properties": {
                "bgforge.falloutSSL.compilePath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to sslc compiler. Drop compile.exe/sslc into system PATH and enter filename or specify full path.\nLeave empty to use one of the compilers shipped with the extension, chosen by bgforge.falloutSSL.compiler."
                },
                "bgforge.falloutSSL.compileOptions": {
                    "type": "string",
                    "default": "-q -p -l -O2 -d -s -n",
                    "description": "Compilation options for compile.exe from sfall modders pack."
                },
                "bgforge.falloutSSL.outputDirectory": {
                    "type": "string",
                    "default": "",
                    "description": "Where to put the compiled Fallout SSL scripts, absolute path. Default is to put compiled scripts next to the source file.\nYou'll probably want to set this to data/scripts of your Fallout 2 game directory."
                },
                "bgforge.falloutSSL.headersDirectory": {
                    "type": "string",
                    "default": "",
                    "description": "Path to an additional directory with Fallout headers to scan for defines.\nLeave empty if all your headers are inside workspace directory. Workspace is always scanned."
                },
                "bgforge.falloutSSL.compileOnValidate": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether validation triggered by save/edit should also write the compiled .int output. Disable this to validate SSL without overwriting compiled artifacts."
                },
                "bgforge.falloutSSL.compiler": {
                    "type": "string",
                    "enum": [
                        "wasm",
                        "built-in"
                    ],
                    "enumDescriptions": [
                        "The reference sslc compiler, built to WebAssembly and shipped with the extension. Each compile runs in a separate process and reads the script through a temporary file on disk.",
                        "The extension's own compiler. Compiles the editor's text directly, writing no temporary file, and produces the same bytes as the WebAssembly one at optimization levels 0 to 2."
                    ],
                    "default": "wasm",
                    "description": "Which compiler to use when no external compilePath is set."
                },
                "bgforge.tssl.emitSsl": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Whether compiling a `.tssl` file should also write the readable `.ssl` beside it.\n\nTSSL compiles straight to Fallout `.int` bytecode, so the SSL text is not produced on the way and nothing downstream needs it. Enable this if your mod still ships generated `.ssl`, or to read what a script became. The emitted text is checked to compile to the same bytes."
                },
                "bgforge.weidu.path": {
                    "type": "string",
                    "default": "weidu",
                    "description": "Path to WeiDU binary. Alternatively, you can add WeiDU to system PATH and leave default here."
                },
                "bgforge.weidu.gamePath": {
                    "type": "string",
                    "default": "",
                    "description": "Absolute path to an IE game. Enables the parse feature on BAF and D files, resolves IE records in workspace files against that game in the binary editor, and auto-loads the game in the IE Resources view. Opening a game in that view writes this setting."
                },
                "bgforge.validate": {
                    "type": "string",
                    "default": "saveAndType",
                    "enum": [
                        "manual",
                        "save",
                        "type",
                        "saveAndType"
                    ],
                    "markdownDescription": "When to run validation.\n\n- `manual`: only when you run the compile/validate command explicitly\n- `save`: automatically when a document is saved\n- `type`: automatically while editing\n- `saveAndType`: automatically on both save and edit\n\n**Note:** validation while editing can be disk intensive, as some compilers require files on disk."
                },
                "bgforge.diagnostics": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Report tree-sitter parse errors as diagnostics, shown alongside compiler diagnostics for the languages that have a parser (Fallout SSL/MSG, WeiDU BAF/D/TP2/TRA).\n\nThis catches structural syntax errors instantly and in-memory, so unlike `bgforge.validate` it runs regardless of validation mode and has no disk cost. Compiler diagnostics (which also catch semantic errors) are controlled separately by `bgforge.validate`. Set to `false` to silence the syntax source without disabling compiler validation."
                },
                "bgforge.debug": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable debug logging in the Output panel (BGforge MLS channel). Useful for troubleshooting rename, include resolution, and other issues."
                },
                "bgforge.binaryEditor.autoDumpJson": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether saving a file in the binary editor should also write a JSON snapshot next to it."
                }
            }
        },
        "keybindings": [
            {
                "command": "extension.bgforge.compile",
                "key": "ctrl+r"
            },
            {
                "command": "extension.bgforge.dialogEditor",
                "key": "ctrl+shift+v",
                "when": "editorLangId == fallout-ssl || resourceExtname == .tssl || editorLangId == weidu-d || resourceExtname == .td"
            }
        ],
        "typescriptServerPlugins": [
            {
                "name": "bgforge-tssl-plugin"
            },
            {
                "name": "bgforge-td-plugin"
            }
        ],
        "iconThemes": [
            {
                "id": "bgforge",
                "label": "BGforge",
                "path": "./themes/bgforge-icon-theme.json"
            }
        ]
    },
    "activationEvents": [
        "onCustomEditor:bgforge.animationEditor",
        "onCustomEditor:bgforge.binaryEditor",
        "onCustomEditor:bgforge.intEditor",
        "onFileSystem:bgforge-ie-resource",
        "onFileSystem:bgforge-int",
        "onLanguage:fallout-msg",
        "onLanguage:fallout-scripts-lst",
        "onLanguage:fallout-ssl",
        "onLanguage:fallout-worldmap-txt",
        "onLanguage:infinity-2da",
        "onLanguage:weidu-baf",
        "onLanguage:weidu-d",
        "onLanguage:weidu-log",
        "onLanguage:weidu-slb",
        "onLanguage:weidu-ssl",
        "onLanguage:weidu-tp2",
        "onLanguage:weidu-tra",
        "onView:bgforge.ieResources",
        "workspaceContains:**/*.tbaf",
        "workspaceContains:**/*.td",
        "workspaceContains:**/*.tssl"
    ],
    "icon": "resources/bgforge.png",
    "engines": {
        "vscode": "^1.91.0"
    },
    "packageManager": "pnpm@11.11.0"
}
