{
    "name": "@bgforge/transpile",
    "version": "0.4.0",
    "description": "Library for transpiling TBAF and TD source files to WeiDU BAF and WeiDU D",
    "keywords": [
        "infinity-engine",
        "modding",
        "transpiler",
        "weidu"
    ],
    "homepage": "https://github.com/BGforgeNet/BGforge-MLS",
    "bugs": {
        "url": "https://github.com/BGforgeNet/BGforge-MLS/issues"
    },
    "license": "SEE LICENSE IN LICENSE.txt",
    "author": "BGforge",
    "repository": {
        "type": "git",
        "url": "https://github.com/BGforgeNet/BGforge-MLS",
        "directory": "transpilers"
    },
    "bin": {
        "fgtp": "out/cli.js"
    },
    "files": [
        "out/",
        "!out/*.map",
        "README.md",
        "CHANGELOG.md",
        "LICENSE.txt"
    ],
    "type": "module",
    "main": "out/index.js",
    "types": "out/index.d.ts",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "import": "./out/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown && chmod +x out/cli.js"
    },
    "dependencies": {
        "cac": "catalog:",
        "diff": "catalog:",
        "esbuild-wasm": "catalog:"
    },
    "devDependencies": {
        "fast-check": "catalog:",
        "tsdown": "catalog:"
    },
    "engines": {
        "node": ">=20"
    }
}
