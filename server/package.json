{
    "name": "@bgforge/mls-server",
    "version": "3.9.1",
    "description": "LSP server for Fallout SSL, WeiDU (BAF/D/TP2), and related modding languages",
    "keywords": [
        "fallout",
        "infinity-engine",
        "language-server",
        "lsp",
        "modding",
        "weidu"
    ],
    "homepage": "https://github.com/BGforgeNet/BGforge-MLS",
    "bugs": {
        "url": "https://github.com/BGforgeNet/BGforge-MLS/issues"
    },
    "license": "SEE LICENSE IN LICENSE.txt",
    "author": "BGforge",
    "repository": {
        "type": "git",
        "url": "https://github.com/BGforgeNet/BGforge-MLS",
        "directory": "server"
    },
    "bin": {
        "bgforge-mls-server": "out/server.js"
    },
    "files": [
        "out/",
        "!out/*.map",
        "LICENSE.txt"
    ],
    "main": "out/server.js",
    "scripts": {
        "test": "./scripts/test.sh",
        "test:unit": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "bench": "vitest bench --run test/perf"
    },
    "dependencies": {
        "esbuild-wasm": "^0.28.1",
        "fast-glob": "^3.3.3",
        "p-limit": "^7.3.0",
        "ts-morph": "^27.0.2",
        "typescript": "^5.9.3",
        "vscode-languageserver": "10.1.0",
        "vscode-languageserver-textdocument": "^1.0.12",
        "web-tree-sitter": "^0.26.10",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@bgforge/format": "workspace:*",
        "@types/node": "^24.13.3",
        "fast-check": "^4.9.0",
        "vitest": "^4.1.10"
    },
    "optionalDependencies": {
        "sslc-emscripten-noderawfs": "https://github.com/sfall-team/sslc/releases/download/2026-05-23-12-48-08/wasm-emscripten-node-noderawfs.tar.gz"
    },
    "engines": {
        "node": ">=20"
    }
}
