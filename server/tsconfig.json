{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["es2023"],
        "sourceMap": true,
        "allowImportingTsExtensions": true,
        "outDir": "out",
        "tsBuildInfoFile": "../tmp/server.tsbuildinfo",
        "paths": {
            "@bgforge/binary/archive": ["../binary/src/archive/index.ts"],
            "@bgforge/format": ["../format/src/index.ts"],
            "@bgforge/format/internal": ["../format/src/internal.ts"]
        }
    },
    "include": [
        "src",
        "test",
        "scripts",
        "../shared",
        "../transpilers",
        "../binary/src/archive",
        "../format/src",
        "../test"
    ],
    "exclude": ["node_modules", ".vscode-test"]
}
