// Constructs no real .tssl in the pinned corpus exercises, so the corpus sweep cannot tell the two
// routes to bytecode apart on them. Each one below was a real divergence or a silent miscompile.

/**
 * An @inline body of more than one call. Every folib inline is a single call, so nothing in the corpus
 * reaches this: the text route writes a semicolon-separated `#define`, the direct route a statement
 * sequence, and the two agreeing is what the differential is here to check.
 * @inline
 */
function greet(who: string): void {
    display_msg("first");
    display_msg(who);
}

/**
 * An @inline body that is an expression rather than a call, parenthesised by its author. The text route
 * splices it into a `#define` and the direct route parses it back, so the two agreeing is what this
 * checks; no folib inline is written this way, so the corpus never reaches the shape.
 * @inline
 */
function has_flag(mask: number): boolean {
    return ((mask & 2) != 0);
}

export function start(): void {
    greet("second");
    if (has_flag(6)) {
        display_msg("flagged");
    }

    // A plain counted loop, as the baseline the cases below sit beside.
    let limit = 3;
    for (let i = 0; i < limit; i++) {
        display_msg(i);
    }

    // sfall_typeof inside a string literal. The text route used to rewrite the whole output, so the
    // literal came out reading "typeof" while the direct route kept it - different string tables.
    let note = "sfall_typeof stays spelled this way in text";
    display_msg(note);

    // Boolean literals. These reached the emitter's default arm and were copied through as source text
    // rather than rendered, which is what let unrenderable syntax reach the output beside them.
    let on = true;
    let off = false;
    if (on && !off) {
        display_msg("both");
    }

    // Bitwise xor and not. The text route spelled these `bxor` and `bnot`, which are not SSL tokens at
    // all - the compiler rejects both - while the direct route emitted the correct `bwxor`/`bwnot`. No
    // script in the corpus uses either operator, so nothing caught it.
    let mask = (limit ^ 6) & ~limit;
    display_msg(mask);

    // A float literal written out. The old bundler normalised 1.0 to 1 and silently turned float
    // division into integer division.
    let ratio = 1.0 * 7 / 2;
    display_msg(ratio);
}
