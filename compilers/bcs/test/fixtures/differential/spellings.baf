/* outer /* inner */ still outer */
IF
	See([ENEMY.HUMANOID.ANYONE])
	See([0x10])
	See([ENEMY.0.0.0x10])
	HPGT([ANYONE],#5)
	HPGT(Player1,-0x10)
	HPGT(Player1,0x19)
	HPGT(Player1,"0xFF")
	HPGT(Player1,"3")
THEN
	RESPONSE #100
		Attack(Player1[1.2.3.4])
		Attack([ENEMY][5.6.7.8])
		Attack([ENEMY][0x10.6.7.8])
		SetGlobal("// x","GLOBAL",1)
		SetGlobal(~~~~~y~~~~~,"GLOBAL",1)
		ApplySpell(Player1,"WIZARD_MAGIC_MISSILE")
		ActionOverride(Player1,Attack([ENEMY])
		Continue()
END

IF
	False()
THEN
END
